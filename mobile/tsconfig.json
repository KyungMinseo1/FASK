{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "types": ["vite/client"],
    "paths": {
      "@desktop/*": ["../desktop/src/*"],
      "*": ["node_modules/@types/*", "node_modules/*"]
    }
  },
  "include": ["src", "tests", "vite.config.ts", "capacitor.config.ts", "../desktop/src/preload/personal.d.ts"]
}
