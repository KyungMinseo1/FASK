# Copy to .env.local (not committed) and fill in to enable the relay option in code pairing.
# Release builds get this from the FASK_RELAY_URL repository variable (.github/workflows/release.yml).
# Must be a bare wss:// origin, the same relay URL the PC uses in Settings > Mobile connection.
VITE_FASK_RELAY_URL=wss://relay.example.com
