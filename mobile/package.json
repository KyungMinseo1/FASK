{
  "name": "fask-mobile",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "FASK Android companion that pairs with the desktop app over TLS",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build",
    "sync": "npm run build && cap sync android",
    "apk": "npm run sync && cd android && gradlew assembleDebug",
    "apk:test": "tsc --noEmit -p tsconfig.json && vite build --mode pairing-test && cap sync android && cd android && gradlew assembleDebug",
    "android": "npm run sync && cap run android",
    "test": "vitest run",
    "test:android": "cd android && gradlew testDebugUnitTest"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capgo/capacitor-share-target": "^8.0.64",
    "@cloudflare/opaque-ts": "^0.7.5",
    "@xyflow/react": "^12.12.0",
    "d3-hierarchy": "^3.1.2",
    "katex": "^0.16.47",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "happy-dom": "^20.14.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
