{
  "name": "fask-relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "wrangler types --strict-vars=false --check && tsc --noEmit",
    "check:deploy": "wrangler deploy --dry-run --outdir .wrangler/dry",
    "deploy": "wrangler deploy",
    "test": "node --test \"test/*.test.mjs\"",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.0",
    "ws": "^8.22.0"
  }
}
